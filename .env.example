# Postgres connection string. For Vercel deploys, use Vercel Postgres, Neon, or Supabase.
DATABASE_URL="postgresql://user:password@host:5432/database"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"

# Your deployed URL in production, http://localhost:3000 in dev
NEXTAUTH_URL="http://localhost:3000"

# Powers the Strategy Agent and Content Agent (lib/ai/). Get one from
# the Claude Platform console. Without it, both agents return a clear
# "not configured" message in the UI — everything else works normally.
ANTHROPIC_API_KEY=""

# Secures the Automation cron endpoint (api/automation/run). Generate
# with: openssl rand -hex 32
# On Vercel, set this as an env var and Vercel Cron sends it
# automatically as "Authorization: Bearer <value>" — see vercel.json
# and the README's Automation section. Also secures api/billing/run
# (the daily trial/invoice/suspension check) — same secret, same header.
CRON_SECRET=""

# Sends billing emails (trial ending, invoice ready, suspended, payment
# confirmed) via Resend (resend.com). Without it, emails are skipped —
# billing status still updates correctly, customers just aren't emailed.
RESEND_API_KEY=""
BILLING_EMAIL_FROM="billing@yourdomain.com"

# Safepay (getsafepay.pk) — Pakistani payment gateway used for the "Pay
# now" button on /billing. Get these from your Safepay merchant
# dashboard. Without them, invoices still generate correctly, but
# customers see a "payments not configured" message instead of a
# checkout link. See README's Billing section — this integration
# hasn't been run against a real Safepay sandbox yet.
SAFEPAY_API_KEY=""
SAFEPAY_V1_SECRET=""
SAFEPAY_WEBHOOK_SECRET=""
SAFEPAY_ENVIRONMENT="sandbox"
